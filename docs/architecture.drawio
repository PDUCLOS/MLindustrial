  <diagram id="p3" name="3. Service d&#x27;inférence et Kubernetes">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-1" value="&lt;b&gt;API de diagnostic&lt;/b&gt; — image sans état, déployable avec Kustomize" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="30" as="geometry" /></mxCell>
        <mxCell id="p3-2" value="Le modèle exporté (JSON XGBoost, quelques centaines de Ko) est embarqué dans l&#x27;image : pas de base, pas de MLflow en production, mise à l&#x27;échelle horizontale triviale." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="47" width="1500" height="22" as="geometry" /></mxCell>
        <mxCell id="p3-3" value="Construction" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="600" as="geometry" /></mxCell>
        <mxCell id="p3-4" value="&lt;b&gt;scripts/export_model.py&lt;/b&gt;&lt;br&gt;CV + réentraînement sur 29&lt;br&gt;roulements, 3 tenus à l&#x27;écart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="p3-5" value="&lt;b&gt;models/&lt;/b&gt;&lt;br&gt;gbm_vibration.json&lt;br&gt;model_card.json · demo_samples.npz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="p3-6" value="&lt;b&gt;Dockerfile.api&lt;/b&gt;&lt;br&gt;python:3.12-slim, xgboost-cpu&lt;br&gt;utilisateur non root" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="p3-7" value="Registre d&#x27;images (pull par les pods)&lt;br&gt;ghcr.io/pduclos/mlindustrial-api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="p3-8" value="Cluster Kubernetes — namespace bearing-diagnosis" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#326ce5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="900" height="600" as="geometry" /></mxCell>
        <mxCell id="p3-9" value="&lt;b&gt;Ingress&lt;/b&gt; (overlay prod)&lt;br&gt;TLS, corps max 8 Mo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="140" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="p3-10" value="&lt;b&gt;Service&lt;/b&gt; bearing-api&lt;br&gt;ClusterIP (NodePort 30765&lt;br&gt;en overlay local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="260" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="p3-11" value="&lt;b&gt;Pod&lt;/b&gt; uvicorn&lt;br&gt;/predict · /samples · /model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="p3-12" value="&lt;b&gt;Pod&lt;/b&gt; uvicorn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="240" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="p3-13" value="&lt;b&gt;Pod&lt;/b&gt; uvicorn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="320" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="p3-14" value="&lt;b&gt;HPA&lt;/b&gt; 3 → 10 réplicas&lt;br&gt;cible CPU 70 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="p3-15" value="&lt;b&gt;PodDisruptionBudget&lt;/b&gt;&lt;br&gt;minAvailable 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="240" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="p3-16" value="&lt;b&gt;NetworkPolicy&lt;/b&gt;&lt;br&gt;entrée 8765 seulement,&lt;br&gt;aucune sortie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="p3-17" value="&lt;b&gt;Sécurité des pods&lt;/b&gt; : runAsNonRoot, readOnlyRootFilesystem, capabilities drop ALL, seccomp RuntimeDefault, pas de token de service account.&lt;br&gt;&lt;b&gt;Sondes&lt;/b&gt; : readiness et liveness sur /health." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="440" width="840" height="70" as="geometry" /></mxCell>
        <mxCell id="p3-18" value="&lt;b&gt;overlays/local&lt;/b&gt; : 1 replica, 1 worker, NodePort &amp;nbsp;·&amp;nbsp; &lt;b&gt;overlays/prod&lt;/b&gt; : 3 réplicas + HPA + Ingress TLS + image du registre. Rendu vérifié par &lt;i&gt;kubectl kustomize&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="540" width="840" height="70" as="geometry" /></mxCell>
        <mxCell id="p3-19" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;superviseur, MES, passerelle&lt;br&gt;IoT (signal 64 kHz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="140" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="p3-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-4" target="p3-5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-5" target="p3-6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-22" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-6" target="p3-7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-23" value="HTTPS JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-19" target="p3-9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-9" target="p3-10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-10" target="p3-11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-10" target="p3-12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-10" target="p3-13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-28" value="scale" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-14" target="p3-11"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="4. Du signal aux indicateurs">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-1" value="&lt;b&gt;Physique avant le ML&lt;/b&gt; — des indicateurs qu&#x27;un responsable maintenance comprend" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="30" as="geometry" /></mxCell>
        <mxCell id="p4-2" value="Le modèle ne voit pas le signal brut : il voit 5 nombres calculés par des formules connues des vibriciens. Une prédiction se discute devant un chef d&#x27;atelier." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="47" width="1500" height="22" as="geometry" /></mxCell>
        <mxCell id="p4-3" value="&lt;b&gt;Accéléromètre&lt;/b&gt;&lt;br&gt;64 000 points / s&lt;br&gt;4 s par mesure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="p4-4" value="&lt;b&gt;RMS&lt;/b&gt;&lt;br&gt;énergie vibratoire globale&lt;br&gt;(usure généralisée)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="p4-5" value="&lt;b&gt;Kurtosis&lt;/b&gt;&lt;br&gt;impulsivité : chocs d&#x27;un&lt;br&gt;défaut localisé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="190" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="p4-6" value="&lt;b&gt;Facteur de crête, crête à crête,&lt;br&gt;asymétrie&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-7" value="&lt;b&gt;Géométrie 6203&lt;/b&gt;&lt;br&gt;billes, diametres, angle&lt;br&gt;(fiche constructeur)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="p4-8" value="&lt;b&gt;BPFO / BPFI / BSF / FTF&lt;/b&gt;&lt;br&gt;fréquence à laquelle une bille&lt;br&gt;frappe le défaut (Hz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="230" height="80" as="geometry" /></mxCell>
