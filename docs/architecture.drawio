  <diagram id="p2" name="2. Protocole d&#x27;évaluation">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-1" value="&lt;b&gt;Évaluer honnetement&lt;/b&gt; — le roulement est l&#x27;unité de découpage, jamais la fenêtre de signal" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-2" value="Une même bague vue en entraînement et en test donnerait des scores flatteurs : chaque découpage ci-dessous garantit qu&#x27;aucun roulement n&#x27;est des deux côtés." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="47" width="1500" height="22" as="geometry" /></mxCell>
        <mxCell id="p2-3" value="Jeu de données : 32 roulements, 2 559 mesures lisibles" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="330" height="600" as="geometry" /></mxCell>
        <mxCell id="p2-4" value="&lt;b&gt;6 sains&lt;/b&gt;&lt;br&gt;K001 à K006" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="290" height="60" as="geometry" /></mxCell>
        <mxCell id="p2-5" value="&lt;b&gt;12 défauts artificiels&lt;/b&gt;&lt;br&gt;électroérosion, gravure, perçage&lt;br&gt;KA01…KA09, KI01…KI08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="290" height="80" as="geometry" /></mxCell>
        <mxCell id="p2-6" value="&lt;b&gt;14 défauts réels&lt;/b&gt;&lt;br&gt;fatigue (pitting) après vieillissement&lt;br&gt;accéléré : KA04, KA15, KI04, KB23…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="290" height="80" as="geometry" /></mxCell>
        <mxCell id="p2-7" value="Chaque roulement : 4 régimes (vitesse, couple, effort radial) x 20 mesures de 4 s." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="290" height="50" as="geometry" /></mxCell>
        <mxCell id="p2-8" value="A. Intra-dataset (Phase 2 publiée)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="520" height="280" as="geometry" /></mxCell>
        <mxCell id="p2-9" value="&lt;b&gt;StratifiedGroupKFold 5 folds&lt;/b&gt;&lt;br&gt;groupe = roulement · tous états confondus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="480" height="60" as="geometry" /></mxCell>
        <mxCell id="p2-10" value="Baseline kurtosis : F1 macro &lt;b&gt;0,682 ± 0,158&lt;/b&gt; (reproduit à l&#x27;identique)&lt;br&gt;XGBoost vibration : F1 macro &lt;b&gt;0,734 ± 0,206&lt;/b&gt;&lt;br&gt;&lt;i&gt;publié : 0,738 ± 0,208 — écart de 0,004, versions de librairies&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="220" width="480" height="80" as="geometry" /></mxCell>
        <mxCell id="p2-11" value="Intervalles qui se chevauchent : le gain du GBM n&#x27;est pas significatif." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="440" y="315" width="480" height="40" as="geometry" /></mxCell>
        <mxCell id="p2-12" value="B. Artificiel → réel (question centrale)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="520" height="290" as="geometry" /></mxCell>
        <mxCell id="p2-13" value="&lt;b&gt;Train&lt;/b&gt; : 12 artificiels + 3 sains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="440" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="p2-14" value="&lt;b&gt;Test&lt;/b&gt; : 14 réels + 3 autres sains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="440" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="p2-15" value="Répété sur les &lt;b&gt;20&lt;/b&gt; partitions 3/3 des roulements sains&lt;br&gt;contrôle : mêmes sains, défauts réels en CV groupée" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="530" width="480" height="60" as="geometry" /></mxCell>
        <mxCell id="p2-16" value="Artificiel → réel : F1 macro &lt;b&gt;0,620 ± 0,102&lt;/b&gt;&lt;br&gt;Contrôle réel → réel : F1 macro &lt;b&gt;0,694 ± 0,107&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="480" height="60" as="geometry" /></mxCell>
        <mxCell id="p2-17" value="Garde-fous dans le code" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="600" height="600" as="geometry" /></mxCell>
        <mxCell id="p2-18" value="&lt;b&gt;assert_no_asset_leakage(train, test)&lt;/b&gt;&lt;br&gt;lève une erreur si un roulement est des deux côtés (src/data/splits.py, testé)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="560" height="70" as="geometry" /></mxCell>
        <mxCell id="p2-19" value="&lt;b&gt;Seuils appris sur le train uniquement&lt;/b&gt;&lt;br&gt;le sens de la règle (kurtosis haute ou basse) n&#x27;est pas supposé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="220" width="560" height="70" as="geometry" /></mxCell>
        <mxCell id="p2-20" value="&lt;b&gt;Moyenne ± écart-type sur les folds&lt;/b&gt;&lt;br&gt;avec 32 roulements, un chiffre seul serait trompeur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="310" width="560" height="70" as="geometry" /></mxCell>
        <mxCell id="p2-21" value="&lt;b&gt;Hash du dataset dans MLflow&lt;/b&gt;&lt;br&gt;chaque métrique est rattachée aux fichiers exacts utilisés" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="400" width="560" height="70" as="geometry" /></mxCell>
        <mxCell id="p2-22" value="&lt;b&gt;Audit « zéro mock » en CI&lt;/b&gt;&lt;br&gt;aucune valeur inventée affichée dans le dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="490" width="560" height="70" as="geometry" /></mxCell>
        <mxCell id="p2-23" value="&lt;b&gt;Résultats négatifs publiés&lt;/b&gt;&lt;br&gt;kurtogramme instable, courant moteur moins bon : documentés, pas cachés" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="580" width="560" height="70" as="geometry" /></mxCell>
        <mxCell id="p2-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-4" target="p2-9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-9" target="p2-10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-5" target="p2-13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-6" target="p2-14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-28" value="modèle figé" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-13" target="p2-14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-14" target="p2-15"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-15" target="p2-16"><mxGeometry relative="1" as="geometry" /></mxCell>
